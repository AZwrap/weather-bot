[Unit]
Description=Weather Bot — slim_dashboard.py (Streamlit)
After=network-online.target slim-daemon.service
Wants=network-online.target

[Service]
# Substitute /USER and /PROJECT_PATH/Weather_Bot at install time.
User=/USER
WorkingDirectory=/PROJECT_PATH/Weather_Bot
Environment=PYTHONUNBUFFERED=1
# Bind to localhost only. Reach it via SSH tunnel:
#   ssh -L 8501:localhost:8501 weather-vps2
ExecStart=/PROJECT_PATH/Weather_Bot/.venv/bin/streamlit run \
    /PROJECT_PATH/Weather_Bot/slim_dashboard.py \
    --server.address 127.0.0.1 \
    --server.port 8501 \
    --server.headless true \
    --browser.gatherUsageStats false

Restart=on-failure
RestartSec=5
Type=simple
KillSignal=SIGTERM
TimeoutStopSec=15

MemoryHigh=384M
MemoryMax=768M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
