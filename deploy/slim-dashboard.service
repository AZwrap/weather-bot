[Unit]
Description=Weather Bot — slim_dashboard.py (custom HTTP dashboard)
After=network-online.target slim-daemon.service
Wants=network-online.target

[Service]
# Substitute /USER and /PROJECT_PATH/Weather_Bot at install time.
User=/USER
WorkingDirectory=/PROJECT_PATH/Weather_Bot
Environment=PYTHONUNBUFFERED=1
# Stdlib HTTP server (no Streamlit). Binds 127.0.0.1:8501 internally.
# Reach it via SSH tunnel:  ssh -L 8501:localhost:8501 weather-vps2
ExecStart=/PROJECT_PATH/Weather_Bot/.venv/bin/python \
    /PROJECT_PATH/Weather_Bot/slim_dashboard.py

Restart=on-failure
RestartSec=5
Type=simple
KillSignal=SIGTERM
TimeoutStopSec=15

MemoryHigh=384M
MemoryMax=768M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
